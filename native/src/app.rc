// משאבי ה-exe: האייקון, חבילת הממשק, משאב הגרסה וה-manifest.
//
// ⚠️ הקובץ הזה נקרא ע"י rc.exe. `version.h` מיוצר ע"י build.ps1 לתוך
// `native/build/`, והוא **אנגלית ו-ASCII בלבד** — קידוד של קובץ שמוכלל
// ב-.rc הוא בדיוק סוג התקלה שאין טעם להיכנס אליה בקובץ מיוצר.
#include <windows.h>

#include "resource.h"
#include "version.h"

// האייקון קודם לכל השאר — ראו resource.h.
IDI_APP_ICON ICON "app_icon.ico"

// חבילת קובצי הממשק (HTML/CSS/JS), דחוסה. זה מה שהופך את ה-exe לתוכנה
// שלמה: אין שום קובץ ממשק לידו.
IDR_WEB_BUNDLE RCDATA "web_bundle.bin"

// ה-manifest: DPI-aware לכל מסך, ו-Common Controls 6. בלי ה-DPI התוכנה
// מטושטשת על מסך בהגדלה, וזה המצב הרגיל בלפטופ.
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_COMMAS
 PRODUCTVERSION APP_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040d = עברית, 04b0 = Unicode. שורת השפה הזאת היא מה שמאפשר
        // ל-Explorer להציג את השדות בעברית בלי להשתמש בקוד-עמוד.
        BLOCK "040d04b0"
        //
        // ⚠️ עברית רק כ-`L"\x05d7"`: בלי ה-L, rc.exe קורא את `\05` כ-escape
        // אוקטלי (התו 0x05) ואת `d7` כטקסט — והשדות יוצאים זבל.
        BEGIN
            VALUE "CompanyName", L"\x05d0\x05d5\x05e6\x05e8\x05d9\x05d0"
            VALUE "FileDescription", L"\x05d7\x05e0\x05d5\x05ea \x05d4\x05ea\x05d5\x05e1\x05e4\x05d9\x05dd \x05e9\x05dc \x05d0\x05d5\x05e6\x05e8\x05d9\x05d0"
            VALUE "FileVersion", APP_VERSION_A
            VALUE "InternalName", "otzaria-plugin-store"
            // חייב להתאים ל-LICENSE שבשורש הריפו.
            VALUE "LegalCopyright", "Copyright (c) 2026 Otzaria Project. Personal Use License 1.0"
            // השם שאיתו הקובץ **מופץ** — נכס ה-release (ראו "Give the Windows
            // asset an ASCII name" ב-ci.yml), ולא השם העברי שעל הדיסק. פער בין
            // השדה הזה לשם שהקובץ מגיע איתו הוא סיגנל היוריסטי של אנטי-וירוס
            // (בינארי ששינה את שמו) — ראו issue #3.
            VALUE "OriginalFilename", "Otzaria-Plugin-Store.exe"
            VALUE "ProductName", L"\x05d7\x05e0\x05d5\x05ea \x05d4\x05ea\x05d5\x05e1\x05e4\x05d9\x05dd \x05e9\x05dc \x05d0\x05d5\x05e6\x05e8\x05d9\x05d0"
            VALUE "ProductVersion", APP_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40d, 1200
    END
END
